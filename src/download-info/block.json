{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lunar-download/download-info",
  "title": "Download Info",
  "category": "lunar-download",
  "description": "Present one download entry with its details and download buttons.",
  "keywords": [ "download", "unduh", "file", "mod" ],
  "textdomain": "lunar-download",
  "attributes": {
    "name": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "integer",
      "default": 0
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "preset": {
      "type": "string",
      "default": "table"
    },
    "rows": {
      "type": "array",
      "default": []
    },
    "links": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": [ "lunar-download-tokens" ],
  "render": "file:./render.php"
}
